 interface SalusIt600 {
     attributes: never;
     commands: {syncRequest: {payload: Buffer}};
-    commandResponses: {syncRequest: {payload: Buffer}; record: {payload: Buffer}; write: {payload: Buffer}; syncResponse: {payload: Buffer}};
+    commandResponses: {
