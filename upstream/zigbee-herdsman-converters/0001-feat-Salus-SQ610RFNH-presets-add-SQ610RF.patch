+        type: "commandEcho",
+        convert: (model, msg, publish, options, meta) => {
+            const echo = msg.data.payload;
+            const pending = it600Echoes.get(`${msg.device.ieeeAddr}/${echo[0]}`);
+            if (pending?.command === echo.subarray(1, 4).toString()) pending.resolve();
+        },
+    } satisfies Fz.Converter<"manuSpecificSalusIt600", SalusIt600, "commandEcho">,
 };
 
 // iT600 protocol: https://github.com/mikkelke/salus-zigbee/blob/main/PROTOCOL.md
 const it600Payload = [{name: "payload", type: Zcl.BuffaloZclDataType.BUFFER}];
 let it600Handle = 0;
+// Writes waiting for the thermostat's echo, by `<ieeeAddr>/<handle>`
+const it600Echoes = new Map<string, {command: string; resolve: () => void}>();
+const it600Queues = new Map<string, Promise<unknown>>();
 
 const salusExtend = {
     addGatewayBasic: () =>
@@ -119,6 +175,8 @@ const salusExtend = {
                 syncRequest: {name: "syncRequest", ID: 0x10, parameters: it600Payload},
                 record: {name: "record", ID: 0x31, parameters: it600Payload},
                 write: {name: "write", ID: 0x32, parameters: it600Payload},
+                // The thermostat answers each write with its handle and command
+                echo: {name: "echo", ID: 0x33, parameters: it600Payload},
                 syncResponse: {name: "syncResponse", ID: 0x81, parameters: it600Payload},
             },
