+++ b/test/salus_controls.test.ts
@@ -0,0 +1,131 @@
+import {afterEach, beforeEach, describe, expect, it, vi} from "vitest";
+import {Zcl} from "zigbee-herdsman";
+import {findByDevice} from "../src/index";
+import * as globalStore from "../src/lib/store";
+import type {Definition, Fz, KeyValueAny, Tz, Zh} from "../src/lib/types";
+import {mockDevice} from "./utils";
+
+const CLUSTER = "manuSpecificSalusIt600";
+
+// iT600 status record (0x71) with a hold type, 21.50 °C measured, 20.50 °C setpoint
+function statusRecord(holdType: number) {
+    const record = Buffer.alloc(50);
+    record[0] = 0x71;
+    record[3] = holdType;
+    record.writeUInt16BE(0x2150, 4);
+    record.writeUInt16BE(0x2050, 9);
+    record[15] = 4;
+    return record;
+}
+
+describe("Salus SQ610RFNH", () => {
+    let device: Zh.Device;
+    let endpoint: Zh.Endpoint;
+    let definition: Definition;
+    let written: string[];
+    let echo: boolean;
+
+    const receive = (type: string, payload: Buffer) => {
+        let result: KeyValueAny = {};
+        for (const converter of definition.fromZigbee.filter((c) => c.cluster === CLUSTER && c.type === type)) {
+            const msg = {data: {payload}, device, endpoint, type, cluster: CLUSTER} as unknown as Fz.Message;
+            result = {...result, ...converter.convert(definition, msg, () => {}, {}, {} as Fz.Meta)};
+        }
+        return result;
+    };
+
+    const set = (key: string, value: string, state: KeyValueAny) => {
+        const converter = definition.toZigbee.find((c) => c.key.includes(key));
+        const meta = {state, message: {[key]: value}, device, mapped: definition, options: {}, endpoint_name: undefined} as unknown as Tz.Meta;
+        return converter.convertSet(endpoint, key, value, meta);
+    };
+
+    beforeEach(async () => {
+        globalStore.clear();
+        device = mockDevice({modelID: "SQ610RFNH", manufacturerName: "SALUS", endpoints: [{ID: 9}]}, "EndDevice");
+        endpoint = device.getEndpoint(9);
+        definition = await findByDevice(device);
+        written = [];
+        echo = true;
+        vi.spyOn(endpoint, "commandResponse").mockImplementation((clusterKey, command, payload) => {
+            const write = (payload as {payload: Buffer}).payload;
+            written.push(`${write.subarray(1, 4).toString()} ${write.subarray(4).toString("hex")}`);
+            if (echo) setImmediate(() => receive("commandEcho", write));
+            return Promise.resolve();
+        });
+    });
+
+    afterEach(() => {
+        vi.useRealTimers();
+    });
+
+    it("matches the SQ610RF as a white label", async () => {
+        const rf = mockDevice({modelID: "SQ610RF", manufacturerName: "SALUS", endpoints: [{ID: 9}]}, "EndDevice");
+        expect((await findByDevice(rf)).model).toBe("SQ610RF");
+        expect(definition.model).toBe("SQ610RFNH");
+    });
+
+    it("parses the thermostat's echo of a write", async () => {
+        await definition.configure?.(device, endpoint, definition);
+        const frame = Buffer.from([0x1d, 0x78, 0x10, 0x01, 0x33, 0x05, ...Buffer.from("B20"), 0x02]);
+        const parsed = Zcl.Frame.fromBuffer(0xfc00, Zcl.Header.fromBuffer(frame), frame, device.customClusters);
+        expect(parsed.command.name).toBe("echo");
+        expect(parsed.payload).toStrictEqual({payload: Buffer.from([0x05, ...Buffer.from("B20"), 0x02])});
+    });
+
+    it("reports hold type and preset, and keeps the preset while off", () => {
+        expect(receive("commandRecord", statusRecord(0))).toMatchObject({hold_type: "schedule", preset: "schedule", system_mode: "heat"});
+        expect(receive("commandRecord", statusRecord(1))).toMatchObject({hold_type: "temporary_hold", preset: "schedule"});
+        expect(receive("commandRecord", statusRecord(2))).toMatchObject({hold_type: "manual", preset: "manual"});
+        expect(receive("commandRecord", statusRecord(6))).toMatchObject({hold_type: "away", preset: "away"});
+        const off = receive("commandRecord", statusRecord(7));
+        expect(off).toMatchObject({hold_type: "standby", system_mode: "off"});
+        expect(off.preset).toBeUndefined();
+    });
+
+    it("turns off to standby", async () => {
+        expect(await set("system_mode", "off", {system_mode: "heat", preset: "schedule"})).toStrictEqual({
+            state: {system_mode: "off", hold_type: "standby"},
+        });
+        expect(written).toStrictEqual(["B20 07"]);
+    });
+
+    it.each([
+        ["schedule", ["B20 02", "B48 04", "B20 00"]],
+        ["manual", ["B20 02", "B48 04"]],
+        ["away", ["B20 02", "B48 04", "B20 06"]],
+    ])("turns on in the preset it had before it was turned off (%s)", async (preset, writes) => {
+        expect(await set("system_mode", "heat", {system_mode: "off", preset})).toStrictEqual({
+            state: {system_mode: "heat", preset, hold_type: preset},
+        });
+        expect(written).toStrictEqual(writes);
+    });
+
+    it("writes nothing when turned on while on, so a running schedule is kept", async () => {
+        expect(await set("system_mode", "heat", {system_mode: "heat", preset: "schedule"})).toStrictEqual({state: {system_mode: "heat"}});
+        expect(written).toStrictEqual([]);
+    });
+
+    it("does not skip an on that waited for an off", async () => {
+        // Both arrive before the off is done, so both get the state from before it
+        const state = {system_mode: "heat", preset: "schedule"};
+        await Promise.all([set("system_mode", "off", state), set("system_mode", "heat", state)]);
+        expect(written).toStrictEqual(["B20 07", "B20 02", "B48 04", "B20 00"]);
+    });
+
+    it("sets a preset, turning the thermostat on when it is off", async () => {
+        await set("preset", "away", {system_mode: "heat", preset: "schedule"});
+        expect(written).toStrictEqual(["B20 06"]);
+        written = [];
+        await set("preset", "schedule", {system_mode: "off", preset: "manual"});
+        expect(written).toStrictEqual(["B20 02", "B48 04", "B20 00"]);
+    });
+
+    it("fails when the thermostat does not echo a write", async () => {
+        vi.useFakeTimers({toFake: ["setTimeout"]});
+        echo = false;
+        const result = expect(set("system_mode", "off", {system_mode: "heat"})).rejects.toThrow("No B20 echo");
+        await vi.advanceTimersByTimeAsync(30000);
+        await result;
+    });
+});
