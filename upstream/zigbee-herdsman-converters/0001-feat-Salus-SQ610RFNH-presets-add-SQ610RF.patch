@@ -157,25 +215,100 @@ const salusExtend = {
     },
 };
 
-async function it600Write(endpoint: Zh.Endpoint, command: string, ...args: number[]) {
+function it600NextHandle() {
     // Handles 1-127, the device uses the others for its own reports
     it600Handle = (it600Handle % 0x7f) + 1;
-    const payload = Buffer.from([it600Handle, ...Buffer.from(command), ...args]);
+    return it600Handle;
+}
+
+async function it600Send(endpoint: Zh.Endpoint, handle: number, command: string, args: number[]) {
+    const payload = Buffer.from([handle, ...Buffer.from(command), ...args]);
     await endpoint.commandResponse<"manuSpecificSalusIt600", "write", SalusIt600>("manuSpecificSalusIt600", "write", {payload});
 }
 
+async function it600Write(endpoint: Zh.Endpoint, command: string, ...args: number[]) {
+    await it600Send(endpoint, it600NextHandle(), command, args);
+}
+
+// Mode changes take several writes, each sent once the thermostat echoed the one before
+async function it600WriteConfirmed(endpoint: Zh.Endpoint, command: string, ...args: number[]) {
+    const handle = it600NextHandle();
+    const key = `${endpoint.deviceIeeeAddress}/${handle}`;
+    const echoed = new Promise<void>((resolve) => it600Echoes.set(key, {command, resolve}));
+    let timer: NodeJS.Timeout | undefined;
+    try {
+        await it600Send(endpoint, handle, command, args);
+        const timeout = new Promise<never>((_resolve, reject) => {
+            timer = setTimeout(() => reject(new Error(`No ${command} echo from '${endpoint.deviceIeeeAddress}'`)), 30000);
+        });
+        await Promise.race([echoed, timeout]);
+    } finally {
+        clearTimeout(timer);
+        it600Echoes.delete(key);
+    }
+}
+
+// Commands to one thermostat run one after the other
+function it600Queue<T>(device: Zh.Device, task: () => Promise<T>): Promise<T> {
+    const run = (it600Queues.get(device.ieeeAddr) ?? Promise.resolve()).then(task, task);
+    it600Queues.set(
+        device.ieeeAddr,
+        run.catch(() => {}),
+    );
+    return run;
+}
+
+// On is manual and the system mode, as the Salus gateway sends it. Schedule or away is written after that.
+async function it600TurnOn(endpoint: Zh.Endpoint, systemMode: string, preset: string) {
+    await it600WriteConfirmed(endpoint, "B20", it600Presets.manual);
+    await it600WriteConfirmed(endpoint, "B48", systemMode === "cool" ? 3 : 4);
+    if (preset !== "manual") await it600WriteConfirmed(endpoint, "B20", it600Presets[preset]);
+    it600Learn(endpoint.getDevice(), {systemMode, preset});
+}
+
 const tzLocal = {
     it600_system_mode: {
         key: ["system_mode"],
         convertSet: async (entity, key, value, meta) => {
             utils.assertEndpoint(entity);
-            if (value === "off") {
-                await it600Write(entity, "B20", 7); // Standby
-            } else {
-                await it600Write(entity, "B20", 2); // Permanent hold
-                await it600Write(entity, "B48", value === "cool" ? 3 : 4);
-            }
-            return {state: {system_mode: value}};
+            utils.assertString(value, key);
+            utils.validateValue(value, ["off", "heat", "cool"]);
+            const device = entity.getDevice();
+            const seqOnArrival = it600Learned(device).seq;
+            return await it600Queue(device, async () => {
+                const state = it600State(device, meta.state, seqOnArrival);
+                if (value === "off") {
+                    await it600WriteConfirmed(entity, "B20", 7); // Standby
+                    it600Learn(device, {systemMode: "off"});
+                    return {state: {system_mode: "off", hold_type: "standby"}};
+                }
+                // Turning it on again would put it in manual and stop its schedule
+                if (state.system_mode === value) return {state: {system_mode: value}};
+                // Back to the preset it had before it was turned off
+                const preset = it600Presets[state.preset] === undefined ? "manual" : state.preset;
+                await it600TurnOn(entity, value, preset);
+                return {state: {system_mode: value, preset, hold_type: preset}};
+            });
+        },
+    } satisfies Tz.Converter,
+    it600_preset: {
+        key: ["preset"],
+        convertSet: async (entity, key, value, meta) => {
+            utils.assertEndpoint(entity);
+            utils.assertString(value, key);
+            utils.validateValue(value, Object.keys(it600Presets));
+            const device = entity.getDevice();
+            const seqOnArrival = it600Learned(device).seq;
+            return await it600Queue(device, async () => {
+                const state = it600State(device, meta.state, seqOnArrival);
+                if (state.system_mode !== "heat" && state.system_mode !== "cool") {
+                    await it600TurnOn(entity, "heat", value);
+                    return {state: {system_mode: "heat", preset: value, hold_type: value}};
+                }
+                await it600WriteConfirmed(entity, "B20", it600Presets[value]);
+                it600Learn(device, {preset: value});
+                return {state: {preset: value, hold_type: value}};
+            });
         },
     } satisfies Tz.Converter,
     it600_setpoint: {
