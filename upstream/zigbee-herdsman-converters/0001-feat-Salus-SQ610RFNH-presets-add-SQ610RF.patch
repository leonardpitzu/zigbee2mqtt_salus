+
+// Hold types in the iT600 status record. A temporary hold is a setpoint changed while the schedule runs, until its next step.
+const it600HoldTypes: Record<number, string> = {0: "schedule", 1: "temporary_hold", 2: "manual", 6: "away", 7: "standby"};
+const it600Presets: Record<string, number> = {schedule: 0, manual: 2, away: 6};
+
+// What was last learned of a thermostat from its status records and from finished writes. seq counts the updates, so a
+// command that had to wait for an earlier one can tell that the state Zigbee2MQTT passed it is out of date.
+interface It600Learned {
+    seq: number;
+    systemMode?: string;
+    preset?: string;
+}
+
+function it600Learned(device: Zh.Device): It600Learned {
+    return globalStore.getValue(device, "it600Learned", {seq: 0});
+}
+
+function it600Learn(device: Zh.Device, update: {systemMode?: string; preset?: string}) {
+    const learned = it600Learned(device);
+    globalStore.putValue(device, "it600Learned", {
+        seq: learned.seq + 1,
+        systemMode: update.systemMode ?? learned.systemMode,
+        preset: update.preset ?? learned.preset,
+    });
+}
+
+function it600State(device: Zh.Device, state: KeyValueAny, seqOnArrival: number): KeyValueAny {
+    const learned = it600Learned(device);
+    if (learned.seq === seqOnArrival) return state;
+    return {...state, system_mode: learned.systemMode ?? state.system_mode, preset: learned.preset ?? state.preset};
 }
 
 const fzLocal = {
@@ -86,14 +123,33 @@ const fzLocal = {
             if (battery !== undefined) result.battery = battery;
             // 12.34 is a placeholder the thermostat regularly sends instead of a reading
             if (record.readUInt16BE(4) !== 0x1234) result.local_temperature = bcd(4) / 100;
+            const holdType = it600HoldTypes[record[3]];
+            if (holdType !== undefined) {
+                result.hold_type = holdType;
+                // No preset while off, so the one to go back to is kept
+                if (holdType !== "standby") result.preset = holdType === "temporary_hold" ? "schedule" : holdType;
+            }
+            it600Learn(msg.device, {systemMode: result.system_mode, preset: result.preset});
             return result;
